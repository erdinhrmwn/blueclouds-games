# apps/web: where the browser reaches the Rivet engine (local dev default shown)
PUBLIC_RIVET_ENDPOINT=http://127.0.0.1:6420

# apps/platform (see docs/platform-api.md)
DATABASE_URL=postgres://platform:platform@127.0.0.1:5432/platform
# `bun run --filter platform keys:generate` prints both keys
PLAY_TOKEN_PRIVATE_KEY=
PLATFORM_SERVER_KEY=change-me-to-a-random-string-of-32-plus-chars
ALLOWED_ORIGINS=http://localhost:5173
PORT=3000
# apps/platform tests: a throwaway database (its schema is dropped)
TEST_DATABASE_URL=postgres://platform:platform@127.0.0.1:5432/platform_test
