# One .env for all apps: copy to .env. Values are local dev defaults (match compose.yaml).

# 0.0.0.0 inside Docker
PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=3000
# How the game server and web server reach the platform (inside Docker: the service name). Never public.
PLATFORM_URL=http://127.0.0.1:3000
# Min 32 chars. Production: openssl rand -base64 32
PLATFORM_SERVER_KEY=dev-only-server-key-change-me-in-production

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=platform
DATABASE_PASSWORD=platform
DATABASE_NAME=platform
# Tests drop this schema on every run
DATABASE_TEST_NAME=platform_test

# Generate with: bun run --filter platform keys:generate
PLAY_TOKEN_PRIVATE_KEY=
PLAY_TOKEN_PUBLIC_KEY=

# Engine admin token, server side only. Min 32 chars. Production: openssl rand -hex 32
RIVET_TOKEN=dev-only-rivet-token-change-me-in-production
# 127.0.0.1, not localhost (engine is IPv4-only)
PUBLIC_RIVET_ENDPOINT=http://127.0.0.1:6420

# Least severe log level each app writes: trace, debug, info, warn, error, fatal or silent
LOG_LEVEL=info
