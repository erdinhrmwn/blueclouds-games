# BlueClouds Games: one .env for every app. Copy to .env (root of the repo).
# Values below are local dev defaults that match compose.yaml (`docker compose up -d`).
# Only the play token keys must be generated; change every value for production.
# Rule: keys used by one app start with that app's name (PLATFORM_…); keys several apps share have no prefix.

# ══ Shared ═══════════════════════════════════════════════════

# Play tokens: the platform signs them (private key), the game server checks them (public key).
# No default: generate both with `bun run --filter platform keys:generate` (Ed25519 JWK, one line each).
PLAY_TOKEN_PRIVATE_KEY=
# Read by the game server once its actors check play tokens (next step).
PLAY_TOKEN_PUBLIC_KEY=

# Key the game server sends when it reports match results to the platform. At least 32 characters.
# Dev default below; for production generate one with `openssl rand -base64 32`.
PLATFORM_SERVER_KEY=dev-only-server-key-change-me-in-production

# ══ Web: game frontend (apps/web) ════════════════════════════

# Where the browser reaches the Rivet engine.
# Production: https://engine.nblueclouds.online
PUBLIC_RIVET_ENDPOINT=http://127.0.0.1:6420

# ══ Platform API (apps/platform) ═════════════════════════════

# Port the API listens on.
PLATFORM_PORT=3000

# Browser origins allowed to call the API (CORS), comma-separated, no trailing slash.
# Local: http://localhost:5173   Production: https://nblueclouds.online
PLATFORM_ALLOWED_ORIGINS=http://localhost:5173

# Postgres 18 connection used by the API and `db:migrate`. PLATFORM_DB_PASSWORD may be empty.
PLATFORM_DB_HOST=127.0.0.1
PLATFORM_DB_PORT=5432
PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=platform
PLATFORM_DB_NAME=platform

# Tests only: a throwaway database on the same server. Its schema is DROPPED on every test run,
# so never use your real database here. Must differ from PLATFORM_DB_NAME.
PLATFORM_TEST_DB_NAME=platform_test
