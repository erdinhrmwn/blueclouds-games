{
	"name": "backoffice",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "bun --bun vite dev --port 5174",
		"build": "bun --bun vite build",
		"start": "bun build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "bun test --env-file=../../.env",
		"admin:create": "bun --env-file=../../.env scripts/admin-create.ts"
	},
	"dependencies": {
		"pino": "^9.14.0",
		"rivetkit": "3.0.7",
		"server": "workspace:*",
		"zod": "^4.1.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "6.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "latest",
		"pino-pretty": "^13.2.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	}
}
