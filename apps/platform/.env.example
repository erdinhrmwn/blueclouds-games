# Platform API (apps/platform)
# Copy to apps/platform/.env, then fill in the two keys marked REQUIRED.
# The database URLs match the dev services in compose.yaml (`docker compose up -d`).

# ── Server ───────────────────────────────────────────────────
# Port the API listens on.
PORT=3000

# Browser origins allowed to call the API (CORS), comma-separated, no trailing slash.
# Local: the game frontend's dev server.   Production: https://nblueclouds.online
ALLOWED_ORIGINS=http://localhost:5173

# ── Database ─────────────────────────────────────────────────
# Postgres 18 connection used by the API and `db:migrate`.
DATABASE_URL=postgres://platform:platform@127.0.0.1:5432/platform

# Tests only: a throwaway database. Its schema is DROPPED on every test run, so never point this at real data.
TEST_DATABASE_URL=postgres://platform:platform@127.0.0.1:5432/platform_test

# ── Secrets (REQUIRED) ───────────────────────────────────────
# Ed25519 private key (JWK, one line) that signs play tokens.
# Generate with `bun run --filter platform keys:generate`. The matching PLAY_TOKEN_PUBLIC_KEY goes to the game server.
PLAY_TOKEN_PRIVATE_KEY=

# Shared key the game server sends when reporting match results. At least 32 characters.
# Generate with `openssl rand -base64 32`. The game server uses the same value.
PLATFORM_SERVER_KEY=
